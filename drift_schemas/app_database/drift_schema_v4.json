  "fixed_sql": [
    {
      "name": "app_settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"app_settings\" (\"key\" TEXT NOT NULL, \"value\" TEXT NOT NULL, PRIMARY KEY (\"key\"));"
        }
      ]
    },
    {
      "name": "observing_locations",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"observing_locations\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"latitude\" REAL NOT NULL, \"longitude\" REAL NOT NULL, \"elevation_meters\" REAL NOT NULL, \"time_zone\" TEXT NOT NULL, \"is_default\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_default\" IN (0, 1)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "equipment_items",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"equipment_items\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"kind\" TEXT NOT NULL, \"sensor_width_mm\" REAL NULL, \"sensor_height_mm\" REAL NULL, \"resolution_x\" INTEGER NULL, \"resolution_y\" INTEGER NULL, \"focal_length_mm\" REAL NULL, \"aperture_mm\" REAL NULL, \"payload_capacity_kg\" REAL NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "optical_profiles",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"optical_profiles\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"camera_id\" TEXT NOT NULL REFERENCES equipment_items (id) ON DELETE RESTRICT, \"optic_id\" TEXT NOT NULL REFERENCES equipment_items (id) ON DELETE RESTRICT, \"mount_id\" TEXT NULL REFERENCES equipment_items (id) ON DELETE RESTRICT, \"focal_multiplier\" REAL NOT NULL DEFAULT 1.0, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "celestial_catalog_entries",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"celestial_catalog_entries\" (\"id\" TEXT NOT NULL, \"designation\" TEXT NOT NULL, \"category\" TEXT NOT NULL, \"source_type\" TEXT NOT NULL, \"ra_degrees\" REAL NOT NULL, \"dec_degrees\" REAL NOT NULL, \"constellation\" TEXT NOT NULL, \"visual_magnitude\" REAL NULL, \"major_axis_arcmin\" REAL NULL, \"minor_axis_arcmin\" REAL NULL, \"messier_number\" INTEGER NULL, \"common_names\" TEXT NOT NULL DEFAULT '', \"aliases\" TEXT NOT NULL DEFAULT '', PRIMARY KEY (\"id\"));"
        }
      ]
    }
